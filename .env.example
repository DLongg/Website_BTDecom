# Sao chép file này thành `.env` và điền giá trị thật. KHÔNG commit file `.env`.

# Kết nối PostgreSQL (dev: khớp với docker-compose.dev.yml)
DATABASE_URL=postgres://btdecom:btdecom_dev@127.0.0.1:5432/btdecom

# Chuỗi bí mật dùng để ký phiên đăng nhập admin (tạo ngẫu nhiên, >= 32 ký tự)
PAYLOAD_SECRET=CHANGE_ME

# Địa chỉ public của website
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Email thông báo (để trống = tắt gửi mail; form vẫn được lưu trong admin)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_NOTIFY_TO=btdecom@gmail.com
